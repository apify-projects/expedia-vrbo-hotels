{
    "name": "expedia-vrbo-hotels-property-scraper",
    "version": "1.0.0",
    "type": "module",
    "description": "Scrapes property details from Expedia, Vrbo and Hotels.com. All three run on the same Expedia Group mobile API, so one run takes any mix of their property URLs and returns one row per URL in the same shape.",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "start": "npm run start:prod",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "typecheck": "tsc --noEmit -p tsconfig.check.json",
        "lint": "eslint src test",
        "lint:fix": "eslint src test --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:smoke": "SMOKE=1 vitest run test/smoke.test.ts"
    },
    "dependencies": {
        "@crawlee/impit-client": "3.17.0",
        "apify": "^3.7.2",
        "crawlee": "^3.17.0",
        "impit": "0.14.1"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.6",
        "@apify/tsconfig": "^0.2.0",
        "@types/node": "^22.10.0",
        "cheerio": "1.0.0-rc.12",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.12.0",
        "prettier": "^3.9.6",
        "tsx": "^4.19.0",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.20.0",
        "vitest": "^2.1.0"
    }
}
